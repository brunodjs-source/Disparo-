{"total": 38.760000000000005, "segs": [{"start": 0.25, "end": 2.49, "text": "Nutricionista, especialista em consórcio, dentista, advogado.", "wt": [0.29, 0.63, 0.97, 1.31, 1.6500000000000001, 1.99]}, {"start": 2.8400000000000003, "end": 5.760000000000001, "text": "Em Campinas, todos perdem cliente no mesmo lugar.", "wt": [2.8800000000000003, 3.22, 3.5600000000000005, 3.9000000000000004, 4.24, 4.58, 4.92, 5.260000000000001]}, {"start": 6.110000000000001, "end": 9.370000000000001, "text": "Seguidor, curtida, indicação. Nenhum deles diz quem vai fechar.", "wt": [6.150000000000001, 6.490000000000001, 6.830000000000001, 7.170000000000002, 7.510000000000002, 7.850000000000001, 8.190000000000001, 8.530000000000001, 8.870000000000001]}, {"start": 9.720000000000002, "end": 12.640000000000002, "text": "Vocês vendem uma decisão que o cliente adia.", "wt": [9.760000000000002, 10.100000000000001, 10.440000000000001, 10.780000000000001, 11.120000000000001, 11.46, 11.8, 12.140000000000002]}, {"start": 12.990000000000002, "end": 16.590000000000003, "text": "Ele pede o preço, diz que vai pensar e some.", "wt": [13.030000000000001, 13.370000000000001, 13.71, 14.05, 14.39, 14.73, 15.07, 15.410000000000002, 15.750000000000002, 16.09]}, {"start": 16.94, "end": 22.240000000000002, "text": "Treze anos de marketing me mostraram: a venda não morre no preço. Morre no intervalo.", "wt": [16.98, 17.32, 17.66, 18.0, 18.34, 18.68, 19.02, 19.36, 19.7, 20.04, 20.380000000000003, 20.720000000000002, 21.060000000000002, 21.400000000000002, 21.740000000000002]}, {"start": 22.590000000000003, "end": 27.210000000000004, "text": "Lançamento encurta esse intervalo: pesquisa, oferta na ordem certa, aquecimento e prazo real.", "wt": [22.630000000000003, 22.970000000000002, 23.310000000000002, 23.650000000000002, 23.990000000000002, 24.330000000000002, 24.67, 25.01, 25.35, 25.69, 26.03, 26.37, 26.71]}, {"start": 27.560000000000002, "end": 31.840000000000003, "text": "Por isso especialista precisa de estrategista: você atende, eu desenho e comando.", "wt": [27.6, 27.94, 28.28, 28.62, 28.96, 29.3, 29.64, 29.98, 30.32, 30.66, 31.0, 31.340000000000003]}, {"start": 32.190000000000005, "end": 36.81, "text": "Me manda sua profissão no botão. Eu te mostro onde o cliente escapa.", "wt": [32.230000000000004, 32.57000000000001, 32.910000000000004, 33.25000000000001, 33.59, 33.93000000000001, 34.27, 34.61000000000001, 34.95, 35.290000000000006, 35.63, 35.970000000000006, 36.31]}]}