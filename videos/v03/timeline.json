{"total": 38.17458333333333, "segs": [{"start": 0.5, "end": 3.460541666666667, "text": "Seu lead está barato, e mesmo assim ninguém compra.", "wt": [0.54, 0.8112500000000001, 1.09425, 1.271125, 1.990459, 2.084834, 2.438584, 2.7334169999999998, 3.063584]}, {"start": 4.010541666666667, "end": 7.86725, "text": "Já vi lançamento com custo por lead lindo, e prejuízo no final.", "wt": [4.050541666666667, 4.2745836666666674, 4.439708666666667, 5.111875666666667, 5.288750666666667, 5.654333666666667, 5.807625666666667, 6.078833666666667, 6.715625666666667, 6.809958666666667, 7.399583666666667, 7.493958666666667]}, {"start": 8.26725, "end": 10.433458333333334, "text": "Lead barato costuma ser lead errado.", "wt": [8.30725, 8.613875, 9.050167, 9.510084, 9.745917, 10.040750000000001]}, {"start": 10.933458333333334, "end": 14.383916666666668, "text": "O número que importa é quanto custa cada cliente, não cada lead.", "wt": [10.973458333333333, 11.091375333333334, 11.445167333333334, 11.539500333333335, 11.987625333333334, 12.023000333333334, 12.306000333333333, 12.648000333333334, 12.907417333333333, 13.567792333333333, 13.803667333333333, 14.063083333333333]}, {"start": 14.833916666666667, "end": 16.9645, "text": "Pra melhorar, mexa em três coisas.", "wt": [14.873916666666666, 15.027208666666667, 15.722958666666667, 16.017791666666664, 16.135708666666666, 16.430541666666663]}, {"start": 17.3645, "end": 19.842458333333333, "text": "O anúncio precisa falar com quem tem o problema.", "wt": [17.4045, 17.534208999999997, 17.946958999999996, 18.347917, 18.701666999999997, 18.878541999999996, 19.114416999999996, 19.267708999999996, 19.338458999999997]}, {"start": 20.24245833333333, "end": 23.333125, "text": "A página precisa carregar rápido e prometer uma coisa só.", "wt": [20.28245833333333, 20.435750333333328, 20.86029233333333, 21.23766733333333, 21.65037533333333, 22.05133333333333, 22.08670833333333, 22.52304233333333, 22.699917333333328, 23.06550033333333]}, {"start": 23.733124999999998, "end": 26.939375, "text": "E a captação precisa durar de 14 a 21 dias.", "wt": [23.773124999999997, 23.902833999999995, 23.973583999999995, 24.551416999999994, 24.928791999999994, 25.247166999999994, 25.365124999999995, 26.037291999999994]}, {"start": 27.389374999999998, "end": 31.944916666666664, "text": "Menos que isso, você não aquece. Mais que isso, esfria.", "wt": [27.429374999999997, 27.853916999999996, 28.042583999999994, 28.608624999999996, 28.891624999999994, 29.103916999999996, 30.386458999999995, 30.716624999999993, 30.893541999999997, 31.447791999999996]}, {"start": 32.544916666666666, "end": 35.17458333333333, "text": "Comenta CAPTAÇÃO, que eu te mando o checklist.", "wt": [32.584916666666665, 33.04483366666666, 33.90566666666666, 34.02358366666666, 34.14154166666666, 34.25945866666666, 34.57783366666666, 34.601416666666665]}]}