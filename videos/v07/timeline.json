{"total": 36.42391666666666, "segs": [{"start": 0.6, "end": 2.8597916666666667, "text": "Fechou o carrinho e você aceitou que acabou.", "wt": [0.64, 1.0645419999999999, 1.1117089999999998, 1.5834169999999999, 1.618792, 1.9253749999999998, 2.349917, 2.432459]}, {"start": 3.459791666666667, "end": 7.125916666666667, "text": "Quem não comprou no seu lançamento é o público mais valioso que você tem.", "wt": [3.499791666666667, 3.735625666666667, 3.9007506666666667, 4.254500666666667, 4.360625666666667, 4.537541666666668, 5.162541666666668, 5.2215006666666675, 5.304041666666667, 5.716791666666667, 5.952625666666667, 6.483291666666667, 6.577625666666667, 6.848833666666668]}, {"start": 7.675916666666667, "end": 9.602291666666666, "text": "Já levantou a mão e só não fechou.", "wt": [7.715916666666667, 7.916375666666667, 8.388083666666667, 8.447041666666667, 8.730083666666667, 8.789041666666668, 8.989500666666666, 9.166375666666667]}, {"start": 10.102291666666666, "end": 14.110916666666666, "text": "Antes de baixar o preço, reabra o carrinho por pouco tempo pra quem pediu.", "wt": [10.142291666666665, 10.484291666666666, 10.555041666666666, 10.920583666666666, 10.979541666666666, 11.616333666666666, 12.017291666666665, 12.052666666666665, 12.453625666666666, 12.618708666666665, 12.972500666666665, 13.326250666666665, 13.491333666666666, 13.715416666666666]}, {"start": 14.510916666666667, "end": 17.295166666666667, "text": "Depois, pergunte pra quem não comprou o motivo.", "wt": [14.550916666666666, 15.352791666666667, 15.883458666666666, 16.036750666666663, 16.225458666666665, 16.414125666666664, 16.756125666666666, 16.791500666666664]}, {"start": 17.695166666666665, "end": 20.176416666666665, "text": "Se foi dinheiro, ofereça uma versão menor.", "wt": [17.735166666666665, 17.947416666666662, 18.11254166666666, 18.772916666666664, 19.280000666666663, 19.421500666666663, 19.763458666666665]}, {"start": 20.576416666666663, "end": 23.132291666666664, "text": "Se foi tempo, mostre uma versão mais curta.", "wt": [20.616416666666662, 20.82866666666666, 21.02916666666666, 21.59520866666666, 21.97254166666666, 22.10225066666666, 22.46783366666666, 22.727250666666663]}, {"start": 23.632291666666664, "end": 25.52483333333333, "text": "Só depois disso venha o desconto.", "wt": [23.672291666666663, 23.90812566666666, 24.26191666666666, 24.627500666666663, 24.88691666666666, 24.945875666666662]}, {"start": 26.12483333333333, "end": 30.065875, "text": "A ordem é reabertura, versão menor e, por último, preço.", "wt": [26.16483333333333, 26.318125333333327, 26.71908333333333, 26.76625033333333, 27.70966733333333, 28.11058333333333, 28.511542333333328, 28.85350033333333, 29.01862533333333, 29.64362533333333]}, {"start": 30.765874999999998, "end": 33.42391666666666, "text": "Comenta RECUPERAÇÃO que eu te mando o passo a passo.", "wt": [30.805874999999997, 31.265791999999994, 31.996916999999996, 32.091249999999995, 32.17379199999999, 32.30349999999999, 32.586541999999994, 32.6455, 32.975708999999995, 33.022875]}]}