[{"text": "Fechou o carrinho e você aceitou que acabou.", "words": [[0.097166, "Fechou"], [0.521708, "o"], [0.568875, "carrinho"], [1.040583, "e"], [1.075958, "você"], [1.382541, "aceitou"], [1.807083, "que"], [1.889625, "acabou"]]}, {"text": "Quem não comprou no seu lançamento é o público mais valioso que você tem.", "words": [[0.097166, "Quem"], [0.333, "não"], [0.498125, "comprou"], [0.851875, "no"], [0.958, "seu"], [1.134916, "lançamento"], [1.759916, "é"], [1.818875, "o"], [1.901416, "público"], [2.314166, "mais"], [2.55, "valioso"], [3.080666, "que"], [3.175, "você"], [3.446208, "tem"]]}, {"text": "Já levantou a mão e só não fechou.", "words": [[0.097166, "Já"], [0.297625, "levantou"], [0.769333, "a"], [0.828291, "mão"], [1.111333, "e"], [1.170291, "só"], [1.37075, "não"], [1.547625, "fechou"]]}, {"text": "Antes de baixar o preço, reabra o carrinho por pouco tempo pra quem pediu.", "words": [[0.097166, "Antes"], [0.439166, "de"], [0.509916, "baixar"], [0.875458, "o"], [0.934416, "preço"], [1.571208, "reabra"], [1.972166, "o"], [2.007541, "carrinho"], [2.4085, "por"], [2.573583, "pouco"], [2.927375, "tempo"], [3.281125, "pra"], [3.446208, "quem"], [3.670291, "pediu"]]}, {"text": "Depois, pergunte pra quem não comprou o motivo.", "words": [[0.097166, "Depois"], [0.899041, "pergunte"], [1.429708, "pra"], [1.583, "quem"], [1.771708, "não"], [1.960375, "comprou"], [2.302375, "o"], [2.33775, "motivo"]]}, {"text": "Se foi dinheiro, ofereça uma versão menor.", "words": [[0.097166, "Se"], [0.309416, "foi"], [0.474541, "dinheiro"], [1.134916, "ofereça"], [1.642, "uma"], [1.7835, "versão"], [2.125458, "menor"]]}, {"text": "Se foi tempo, mostre uma versão mais curta.", "words": [[0.097166, "Se"], [0.309416, "foi"], [0.509916, "tempo"], [1.075958, "mostre"], [1.453291, "uma"], [1.583, "versão"], [1.948583, "mais"], [2.208, "curta"]]}, {"text": "Só depois disso venha o desconto.", "words": [[0.097166, "Só"], [0.333, "depois"], [0.686791, "disso"], [1.052375, "venha"], [1.311791, "o"], [1.37075, "desconto"]]}, {"text": "A ordem é reabertura, versão menor e, por último, preço.", "words": [[0.097166, "A"], [0.250458, "ordem"], [0.651416, "é"], [0.698583, "reabertura"], [1.642, "versão"], [2.042916, "menor"], [2.443875, "e"], [2.785833, "por"], [2.950958, "último"], [3.575958, "preço"]]}, {"text": "Comenta RECUPERAÇÃO que eu te mando o passo a passo.", "words": [[0.097166, "Comenta"], [0.557083, "RECUPERAÇÃO"], [1.288208, "que"], [1.382541, "eu"], [1.465083, "te"], [1.594791, "mando"], [1.877833, "o"], [1.936791, "passo"], [2.267, "a"], [2.314166, "passo"]]}]