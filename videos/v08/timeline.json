{"total": 38.06816666666667, "segs": [{"start": 0.6, "end": 2.7042083333333333, "text": "Todo lançamento seu começa do zero.", "wt": [0.64, 0.923042, 1.595209, 1.772084, 2.220209, 2.349917]}, {"start": 3.3042083333333334, "end": 5.8252500000000005, "text": "Lançamento não deveria ser um evento isolado.", "wt": [3.3442083333333334, 4.0989173333333335, 4.2286253333333335, 4.594208333333334, 4.782875333333334, 4.912625333333334, 5.289958333333334]}, {"start": 6.37525, "end": 8.342958333333334, "text": "Ele é o início de uma máquina de vendas.", "wt": [6.41525, 6.615709000000001, 6.6628750000000005, 6.7336670000000005, 7.099209000000001, 7.169959, 7.3115000000000006, 7.724209000000001, 7.853917000000001]}, {"start": 8.842958333333334, "end": 11.533833333333334, "text": "Depois do lançamento, faça três coisas.", "wt": [8.882958333333333, 9.331083333333334, 9.413625333333334, 10.286250333333333, 10.687208333333333, 11.017375333333334]}, {"start": 11.933833333333334, "end": 15.643666666666668, "text": "Reúna os depoimentos dos primeiros alunos nos primeiros sete dias.", "wt": [11.973833333333333, 12.421958333333334, 12.504500333333334, 13.212042333333335, 13.388917333333334, 13.742708333333335, 14.249792333333334, 14.426667333333333, 14.851208333333334, 15.193167333333333]}, {"start": 16.043666666666667, "end": 20.630041666666667, "text": "Ofereça o próximo produto pra quem comprou, porque cliente satisfeito compra de novo.", "wt": [16.083666666666666, 16.590750666666665, 16.637916666666666, 17.062458666666664, 17.486958666666666, 17.640291666666663, 17.805375666666663, 18.489333666666663, 18.831291666666665, 19.255833666666664, 19.904416666666663, 20.211041666666667, 20.317166666666665]}, {"start": 21.030041666666666, "end": 24.63325, "text": "E transforme o que mais converteu no lançamento em uma venda contínua:", "wt": [21.070041666666665, 21.187958666666663, 21.801166666666663, 21.84833366666666, 21.954458666666664, 22.202125666666664, 22.685625666666663, 22.768166666666662, 23.404958666666662, 23.487500666666662, 23.676166666666663, 24.006375666666663]}, {"start": 25.13325, "end": 27.972166666666666, "text": "anúncio, página e sequência rodando todo mês.", "wt": [25.17325, 25.916166999999998, 26.317124999999997, 26.364292, 26.871374999999997, 27.295875, 27.590708999999997]}, {"start": 28.572166666666668, "end": 31.91241666666667, "text": "Assim o próximo lançamento já começa com prova e com caixa.", "wt": [28.612166666666667, 29.048500666666666, 29.131041666666665, 29.508416666666665, 30.121583666666666, 30.263125666666667, 30.699416666666664, 30.888125666666667, 31.253666666666664, 31.324416666666664, 31.513125666666667]}, {"start": 32.61241666666667, "end": 35.06816666666667, "text": "Comenta PERPÉTUO que eu te explico como montar.", "wt": [32.65241666666667, 33.100541666666665, 33.66658366666667, 33.749125666666664, 33.84345866666666, 33.93779166666667, 34.374125666666664, 34.58637566666667]}]}