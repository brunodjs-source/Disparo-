[{"text": "Todo lançamento seu começa do zero.", "words": [[0.097166, "Todo"], [0.380208, "lançamento"], [1.052375, "seu"], [1.22925, "começa"], [1.677375, "do"], [1.807083, "zero"]]}, {"text": "Lançamento não deveria ser um evento isolado.", "words": [[0.097166, "Lançamento"], [0.851875, "não"], [0.981583, "deveria"], [1.347166, "ser"], [1.535833, "um"], [1.665583, "evento"], [2.042916, "isolado"]]}, {"text": "Ele é o início de uma máquina de vendas.", "words": [[0.097166, "Ele"], [0.297625, "é"], [0.344791, "o"], [0.415583, "início"], [0.781125, "de"], [0.851875, "uma"], [0.993416, "máquina"], [1.406125, "de"], [1.535833, "vendas"]]}, {"text": "Depois do lançamento, faça três coisas.", "words": [[0.097166, "Depois"], [0.545291, "do"], [0.627833, "lançamento"], [1.500458, "faça"], [1.901416, "três"], [2.231583, "coisas"]]}, {"text": "Reúna os depoimentos dos primeiros alunos nos primeiros sete dias.", "words": [[0.097166, "Reúna"], [0.545291, "os"], [0.627833, "depoimentos"], [1.335375, "dos"], [1.51225, "primeiros"], [1.866041, "alunos"], [2.373125, "nos"], [2.55, "primeiros"], [2.974541, "sete"], [3.3165, "dias"]]}, {"text": "Ofereça o próximo produto pra quem comprou, porque cliente satisfeito compra de novo.", "words": [[0.097166, "Ofereça"], [0.60425, "o"], [0.651416, "próximo"], [1.075958, "produto"], [1.500458, "pra"], [1.653791, "quem"], [1.818875, "comprou"], [2.502833, "porque"], [2.844791, "cliente"], [3.269333, "satisfeito"], [3.917916, "compra"], [4.224541, "de"], [4.330666, "novo"]]}, {"text": "E transforme o que mais converteu no lançamento em uma venda contínua:", "words": [[0.097166, "E"], [0.215083, "transforme"], [0.828291, "o"], [0.875458, "que"], [0.981583, "mais"], [1.22925, "converteu"], [1.71275, "no"], [1.795291, "lançamento"], [2.432083, "em"], [2.514625, "uma"], [2.703291, "venda"], [3.0335, "contínua"]]}, {"text": "anúncio, página e sequência rodando todo mês.", "words": [[0.097166, "anúncio"], [0.840083, "página"], [1.241041, "e"], [1.288208, "sequência"], [1.795291, "rodando"], [2.219791, "todo"], [2.514625, "mês"]]}, {"text": "Assim o próximo lançamento já começa com prova e com caixa.", "words": [[0.097166, "Assim"], [0.5335, "o"], [0.616041, "próximo"], [0.993416, "lançamento"], [1.606583, "já"], [1.748125, "começa"], [2.184416, "com"], [2.373125, "prova"], [2.738666, "e"], [2.809416, "com"], [2.998125, "caixa"]]}, {"text": "Comenta PERPÉTUO que eu te explico como montar.", "words": [[0.097166, "Comenta"], [0.545291, "PERPÉTUO"], [1.111333, "que"], [1.193875, "eu"], [1.288208, "te"], [1.382541, "explico"], [1.818875, "como"], [2.031125, "montar"]]}]