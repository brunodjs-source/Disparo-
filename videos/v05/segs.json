[{"text": "Sua live lotou e ninguém comprou.", "words": [[0.097166, "Sua"], [0.392, "live"], [0.757541, "lotou"], [1.123125, "e"], [1.1585, "ninguém"], [1.547625, "comprou"]]}, {"text": "Já assisti centenas de eventos de lançamento.", "words": [[0.097166, "Já"], [0.356583, "assisti"], [0.769333, "centenas"], [1.288208, "de"], [1.37075, "eventos"], [1.807083, "de"], [1.901416, "lançamento"]]}, {"text": "Os que não vendem têm um erro em comum: ensinam demais.", "words": [[0.097166, "Os"], [0.297625, "que"], [0.415583, "não"], [0.60425, "vendem"], [0.958, "têm"], [1.123125, "um"], [1.3, "erro"], [1.51225, "em"], [1.594791, "comum"], [2.219791, "ensinam"], [2.667916, "demais"]]}, {"text": "Evento que vende segue três passos.", "words": [[0.097166, "Evento"], [0.592458, "que"], [0.710375, "vende"], [1.040583, "segue"], [1.417916, "três"], [1.71275, "passos"]]}, {"text": "Primeiro, mostra o problema e o custo de continuar nele.", "words": [[0.097166, "Primeiro"], [0.781125, "mostra"], [1.170291, "o"], [1.205666, "problema"], [1.677375, "e"], [1.736333, "o"], [1.818875, "custo"], [2.172625, "de"], [2.267, "continuar"], [2.809416, "nele"]]}, {"text": "Depois, mostra que existe outro caminho e que outras pessoas já fizeram.", "words": [[0.097166, "Depois"], [0.922625, "mostra"], [1.347166, "que"], [1.4415, "existe"], [1.818875, "outro"], [2.0665, "caminho"], [2.491041, "e"], [2.561791, "que"], [2.726875, "outras"], [3.0335, "pessoas"], [3.517, "já"], [3.623125, "fizeram"]]}, {"text": "Por último, apresenta o seu método como esse caminho.", "words": [[0.097166, "Por"], [0.274041, "último"], [0.851875, "apresenta"], [1.358958, "o"], [1.394333, "seu"], [1.571208, "método"], [1.99575, "como"], [2.278791, "esse"], [2.502833, "caminho"]]}, {"text": "O conteúdo serve pra provar que você sabe, não pra entregar tudo.", "words": [[0.097166, "O"], [0.203291, "conteúdo"], [0.733958, "serve"], [1.134916, "pra"], [1.276416, "provar"], [1.653791, "que"], [1.759916, "você"], [2.007541, "sab