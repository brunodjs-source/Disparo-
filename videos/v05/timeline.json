{"total": 36.858375, "segs": [{"start": 0.6, "end": 2.5233333333333334, "text": "Sua live lotou e ninguém comprou.", "wt": [0.64, 0.934834, 1.3003749999999998, 1.665959, 1.7013340000000001, 2.090459]}, {"start": 3.1233333333333335, "end": 5.63375, "text": "Já assisti centenas de eventos de lançamento.", "wt": [3.1633333333333336, 3.4227503333333336, 3.8355003333333335, 4.3543753333333335, 4.436917333333334, 4.873250333333334, 4.967583333333334]}, {"start": 6.18375, "end": 9.308125, "text": "Os que não vendem têm um erro em comum: ensinam demais.", "wt": [6.22375, 6.424209, 6.542167, 6.730834, 7.084584, 7.249709, 7.426584, 7.638834, 7.721375, 8.346375, 8.794500000000001]}, {"start": 9.808125, "end": 11.995750000000001, "text": "Evento que vende segue três passos.", "wt": [9.848125, 10.343417, 10.461333999999999, 10.791542, 11.168875, 11.463709]}, {"start": 12.395750000000001, "end": 15.487041666666668, "text": "Primeiro, mostra o problema e o custo de continuar nele.", "wt": [12.43575, 13.119709, 13.508875000000002, 13.54425, 14.015959, 14.074917000000001, 14.157459000000001, 14.511209000000001, 14.605584, 15.148000000000001]}, {"start": 15.887041666666669, "end": 19.945833333333336, "text": "Depois, mostra que existe outro caminho e que outras pessoas já fizeram.", "wt": [15.92704166666667, 16.752500666666666, 17.177041666666668, 17.271375666666668, 17.648750666666665, 17.896375666666668, 18.320916666666665, 18.391666666666666, 18.556750666666666, 18.863375666666666, 19.346875666666666, 19.453000666666668]}, {"start": 20.345833333333335, "end": 23.22191666666667, "text": "Por último, apresenta o seu método como esse caminho.", "wt": [20.385833333333334, 20.562708333333333, 21.140542333333332, 21.647625333333334, 21.683000333333332, 21.85987533333333, 22.284417333333334, 22.567458333333335, 22.79150033333333]}, {"start": 23.72191666666667, "end": 27.421000000000003, "text": "O conteúdo serve pra provar que você sabe, não pra entregar tudo.", "wt": [23.761916666666668, 23.868041666666667, 24.398708666666668, 24.799666666666667, 24.941166666666668, 25.31854166666667, 25.424666666666667, 25.672291666666666, 26.261916666666668, 26.49775066666667, 26.639291666666665, 27.063791666666667]}, {"start": 28.021000000000004, "end": 31.092750000000006, "text": "Quem aprende tudo de graça não sente que precisa de você.", "wt": [28.061000000000003, 28.27325, 28.744959, 28.992625000000004, 29.098750000000003, 29.499667000000002, 29.664792000000002, 30.042125000000002, 30.136459000000002, 30.572792000000003, 30.667125000000002]}, {"start": 31.792750000000005, "end": 33.858375, "text": "Comenta EVENTO que eu te mando o roteiro.", "wt": [31.832750000000004, 32.280875, 32.693584, 32.787959, 32.882292, 33.023792, 33.354000000000006, 33.389375]}]}