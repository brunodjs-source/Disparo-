{"total": 36.669000000000004, "segs": [{"start": 0.6, "end": 3.44775, "text": "Você abriu o carrinho e ficou esperando as vendas caírem.", "wt": [0.64, 0.9937920000000001, 1.276792, 1.3239589999999999, 1.783875, 1.8192499999999998, 2.114042, 2.5385839999999997, 2.691875, 3.033875]}, {"start": 4.04775, "end": 8.185333333333332, "text": "Em lançamento, a abertura do carrinho é a largada, não a linha de chegada.", "wt": [4.08775, 4.205667, 5.007584, 5.101917, 5.585375, 5.691542, 6.127834, 6.198584, 6.234, 6.976917, 7.259917, 7.307084, 7.566542, 7.660875000000001]}, {"start": 8.735333333333333, "end": 11.764083333333334, "text": "Nos dias de carrinho aberto, cada dia tem uma ação.", "wt": [8.775333333333332, 9.046583333333333, 9.353167333333333, 9.459292333333332, 9.848458333333333, 10.556000333333333, 10.827208333333333, 11.086667333333333, 11.275333333333332, 11.428625333333333]}, {"start": 12.264083333333334, "end": 14.557833333333335, "text": "Dia um: bônus pra quem entrar primeiro.", "wt": [12.304083333333333, 12.563500333333334, 13.058792333333333, 13.483333333333333, 13.636625333333333, 13.837125333333333, 14.108333333333333]}, {"start": 14.957833333333335, "end": 16.987916666666667, "text": "Dia dois: depoimentos e prova.", "wt": [14.997833333333334, 15.280875333333334, 15.846875333333335, 16.495458333333332, 16.613417333333334]}, {"start": 17.387916666666666, "end": 20.253208333333333, "text": "Dia três: uma live respondendo objeções.", "wt": [17.427916666666665, 17.734541666666665, 18.465666666666664, 18.654333666666663, 18.984541666666665, 19.538750666666665]}, {"start": 20.653208333333332, "end": 23.858583333333332, "text": "Último dia: lembrete de fechamento em todos os canais.", "wt": [20.69320833333333, 21.09416733333333, 21.63662533333333, 22.12008333333333, 22.20262533333333, 22.76866733333333, 22.886625333333328, 23.20500033333333, 23.35829233333333]}, {"start": 24.358583333333332, "end": 26.457083333333333, "text": "De hora em hora, nas últimas horas.", "wt": [24.39858333333333, 24.59904233333333, 24.82312533333333, 24.92925033333333, 25.38916733333333, 25.53066733333333, 25.96700033333333]}, {"start": 27.057083333333335, "end": 30.488500000000002, "text": "E alguém do seu time chamando no WhatsApp quem clicou e não comprou.", "wt": [27.097083333333334, 27.215000333333332, 27.533417333333333, 27.63954233333333, 27.816417333333334, 28.075875333333332, 28.48858333333333, 28.55933333333333, 29.18433333333333, 29.36125033333333, 29.797542333333332, 29.844708333333333, 30.06879233333333]}, {"start": 31.1885, "end": 33.669000000000004, "text": "Comenta CARRINHO, que eu te mando o cronograma.", "wt": [31.2285, 31.676624999999998, 32.313417, 32.431334, 32.54925, 32.678959, 32.985583999999996, 33.020959]}]}