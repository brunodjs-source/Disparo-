[{"text": "O lead se inscreveu no seu evento e esqueceu de você no dia seguinte.", "words": [[0.097166, "O"], [0.203291, "lead"], [0.545291, "se"], [0.651416, "inscreveu"], [1.111333, "no"], [1.217458, "seu"], [1.394333, "evento"], [1.7835, "e"], [1.818875, "esqueceu"], [2.278791, "de"], [2.373125, "você"], [2.750458, "no"], [2.880208, "dia"], [3.092458, "seguinte"]]}, {"text": "A maior parte dos lançamentos perde a audiência entre a inscrição e o evento.", "words": [[0.097166, "A"], [0.203291, "maior"], [0.509916, "parte"], [0.863666, "dos"], [1.005208, "lançamentos"], [1.700958, "perde"], [2.007541, "a"], [2.042916, "audiência"], [2.573583, "entre"], [2.750458, "a"], [2.785833, "inscrição"], [3.363666, "e"], [3.434416, "o"], [3.528791, "evento"]]}, {"text": "Esse intervalo é onde eu mais trabalho.", "words": [[0.097166, "Esse"], [0.321208, "intervalo"], [0.934416, "é"], [1.005208, "onde"], [1.276416, "eu"], [1.347166, "mais"], [1.618416, "trabalho"]]}, {"text": "Entre a captação e o evento, o lead precisa receber três coisas.", "words": [[0.097166, "Entre"], [0.392, "a"], [0.427375, "captação"], [1.005208, "e"], [1.064166, "o"], [1.134916, "evento"], [1.830666, "o"], [1.913208, "lead"], [2.231583, "precisa"], [2.644333, "receber"], [3.080666, "três"], [3.399041, "coisas"]]}, {"text": "Um motivo pra aparecer: o que ele vai sair sabendo.", "words": [[0.097166, "Um"], [0.215083, "motivo"], [0.675, "pra"], [0.828291, "aparecer"], [1.689166, "o"], [1.748125, "que"], [1.866041, "ele"], [1.99575, "vai"], [2.160833, "sair"], [2.47925, "sabendo"]]}, {"text": "Um lembrete em cada canal: e-mail, WhatsApp e stories.", "words": [[0.097166, "Um"], [0.250458, "lembrete"], [0.74575, "em"], [0.828291, "cada"], [1.08775, "canal"], [1.748125, "e-mail"], [2.384916, "WhatsApp"], [3.045291, "e"], [3.080666, "stories"]]}, {"text": "E uma pequena tarefa antes do evento, como responder uma pergunta.", "words": [[0.097166, "E"], [0.226875, "uma"], [0.427375, "pequena"], [0.840083, "tarefa"