[{"text": "Seu produto é bom. A sua oferta é que não convence.", "words": [[0.097166, "Seu"], [0.380208, "produto"], [0.863666, "é"], [0.934416, "bom"], [2.028291, "A"], [2.134416, "sua"], [2.323125, "oferta"], [2.818416, "é"], [2.877375, "que"], [3.007083, "não"], [3.207541, "convence"]]}, {"text": "Quando um lançamento trava no carrinho, quase sempre o problema está em como a oferta foi montada.", "words": [[0.097166, "Quando"], [0.356583, "um"], [0.427375, "lançamento"], [1.017, "trava"], [1.3, "no"], [1.406125, "carrinho"], [2.090083, "quase"], [2.432083, "sempre"], [2.797625, "o"], [2.833, "problema"], [3.24575, "está"], [3.458, "em"], [3.540583, "como"], [3.741041, "a"], [3.776416, "oferta"], [4.21275, "foi"], [4.342458, "montada"]]}, {"text": "Oferta forte tem cinco partes. Nessa ordem.", "words": [[0.097166, "Oferta"], [0.627833, "forte"], [1.040583, "tem"], [1.205666, "cinco"], [1.594791, "partes"], [2.936333, "Nessa"], [3.325458, "ordem"]]}, {"text": "A oportunidade: por que agora.", "words": [[0.097166, "A"], [0.250458, "oportunidade"], [1.288208, "por"], [1.465083, "que"], [1.642, "agora"]]}, {"text": "A prova: quem já conseguiu.", "words": [[0.097166, "A"], [0.238666, "prova"], [0.899041, "quem"], [1.111333, "já"], [1.252833, "conseguiu"]]}, {"text": "A história: por que você.", "words": [[0.097166, "A"], [0.215083, "história"], [0.922625, "por"], [1.099541, "que"], [1.276416, "você"]]}, {"text": "A objeção, respondida antes de aparecer.", "words": [[0.097166, "A"], [0.26225, "objeção"], [1.170291, "respondida"], [1.795291, "antes"], [2.149041, "de"], [2.219791, "aparecer"]]}, {"text": "E só no final... o preço.", "words": [[0.097166, "E"], [0.215083, "só"], [0.427375, "no"], [0.509916, "final"], [1.099541, "o"], [1.205666, "preço"]]}, {"text": "Quem mostra o preço primeiro, faz o cliente comparar valor com dinheiro antes de entender o que está levando.", "words": [[0.097166, "Quem"], [0.309416, "mostra"], [0.698583, "o"], [0.733958, "preço"], [1.028791, "primeiro"], [1.689166, "faz"], [1.877833, "o"], [2.019333, "cliente"], [2.455666, "comparar"], [2.868416, "valor"], [3.186791, "com"], [3.351875, "dinheiro"], [3.717458, "antes"], [4.024041, "de"], [4.094791, "entender"], [4.542916, "o"], [4.613666, "que"], [4.696208, "está"], [4.884916, "levando"]]}, {"text": "Comenta OFERTA, que eu te mando a estrutura completa.", "words": [[0.097166, "Comenta"], [0.521708, "OFERTA"], [1.193875, "que"], [1.3, "eu"], [1.417916, "te"], [1.559416, "mando"], [1.866041, "a"], [1.913208, "estrutura"], [2.432083, "completa"]]}]